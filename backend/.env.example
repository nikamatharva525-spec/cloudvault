# Select local for development or s3 for durable cloud storage.
STORAGE_BACKEND=s3

# Required for S3.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=

# Required for the single-user password gate.
CLOUDVAULT_ACCESS_EMAIL=
CLOUDVAULT_ACCESS_PASSWORD=
CLOUDVAULT_SESSION_SECRET=

# Optional. Defaults to localhost:5173 and localhost:5174 for development.
CORS_ALLOWED_ORIGINS=

# Optional alternative for local development only.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DATA_PATH=cloudvault-data
